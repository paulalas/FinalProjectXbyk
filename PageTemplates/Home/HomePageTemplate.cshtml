@using Kentico.PageBuilder.Web.Mvc

@model TemplateViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="home-page">
    <!-- Hero Section - Editable Area 1 (full width) -->
    <section class="hero-section">
        <editable-area area-identifier="hero" />
    </section>

    <!-- Main Content - Editable Area 2 -->
    <section class="main-content py-5">
        <div class="container">
            <editable-area area-identifier="mainContent" />
        </div>
    </section>

    <!-- Features Section - Editable Area 3 -->
    <section class="cta-section py-5">
        <div class="container">
            <editable-area area-identifier="callToAction1" />
        </div>
    </section>

    <!-- Call to Action - Editable Area 4 -->
    <section class="cta-section py-5">
        <div class="container">
            <editable-area area-identifier="callToAction2" />
        </div>
    </section>
</div>
