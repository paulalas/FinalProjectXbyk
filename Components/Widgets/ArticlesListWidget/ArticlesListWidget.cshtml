@using FinalProject
@using FinalProject.Widgets
@using CMS.Websites

@model FinalProject.Widgets.ArticlesListWidgetViewModel

@{
    var widgetId = $"al_{Guid.NewGuid().ToString("N").Substring(0, 8)}";
}

<style>
    .articles-list-widget {
        padding: 80px 0 60px;
        background: #F6F6F6;
    }

    .articles-list-widget .section-title {
        padding-bottom: 50px;
        overflow: hidden;
    }

    .articles-list-widget .section-title h2 {
        font-weight: 600;
        font-size: 35px;
        color: #232323;
    }

    .articles-list-widget .section-title h2 span {
        color: #28ABE3;
    }

    .articles-list-widget .title-border {
        height: 2px;
        margin: 20px auto;
        width: 80px;
        background: #28ABE3;
    }

    .articles-list-widget .section-title p {
        color: #848484;
        margin: 0 auto;
    }

    .articles-list-widget .filter-bar {
        margin-bottom: 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

    .articles-list-widget .filter-btn {
        display: inline-block;
        padding: 8px 22px;
        border: 1px solid #28ABE3;
        border-radius: 40px;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        text-decoration: none;
        color: #28ABE3;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .articles-list-widget .filter-btn:hover,
    .articles-list-widget .filter-btn.active {
        background: #28ABE3;
        color: #fff;
    }

    .articles-list-widget .post-item {
        background: #fff;
        margin-bottom: 30px;
    }

    .articles-list-widget .post-item .media-wrapper img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
    }

    .articles-list-widget .post-item .content {
        padding: 20px;
    }

    .articles-list-widget .post-item .content .article-category {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #28ABE3;
        margin-bottom: 8px;
        display: block;
    }

    .articles-list-widget .post-item .content h3 a {
        color: #000;
        text-decoration: none;
    }

    .articles-list-widget .post-item .content h3 a:hover {
        color: #28ABE3;
    }

    .articles-list-widget .post-item .content p {
        color: #757575;
        margin: 10px 0;
    }

    .articles-list-widget .btn-article {
        background: #28ABE3;
        border: 1px solid #28ABE3;
        color: #fff;
        display: inline-block;
        font-size: 14px;
        letter-spacing: 1px;
        padding: 12px 25px;
        text-transform: uppercase;
        border-radius: 40px;
        text-decoration: none;
        margin: 15px 0;
        transition: opacity 0.3s ease;
    }

    .articles-list-widget .btn-article:hover {
        opacity: 0.8;
        color: #fff;
        text-decoration: none;
    }

    .articles-list-widget .article-card {
        display: none;
    }

    .articles-list-widget .article-card.visible {
        display: block;
    }

    .articles-list-widget .pagination-bar {
        margin-top: 40px;
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .articles-list-widget .page-btn {
        display: inline-block;
        width: 40px;
        height: 40px;
        line-height: 38px;
        text-align: center;
        border: 1px solid #28ABE3;
        border-radius: 50%;
        font-size: 14px;
        color: #28ABE3;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
        user-select: none;
    }

    .articles-list-widget .page-btn:hover,
    .articles-list-widget .page-btn.active {
        background: #28ABE3;
        color: #fff;
    }

    .articles-list-widget .page-btn.disabled {
        border-color: #ccc;
        color: #ccc;
        pointer-events: none;
    }

    .articles-list-widget .no-results {
        color: #848484;
        text-align: center;
        padding: 40px 0;
        display: none;
    }

    .articles-list-widget .search-bar {
        margin-bottom: 30px;
        display: flex;
        justify-content: center;
    }

    .articles-list-widget .search-bar .search-wrap {
        position: relative;
        width: 100%;
        max-width: 500px;
    }

    .articles-list-widget .search-bar input {
        width: 100%;
        padding: 12px 50px 12px 20px;
        border: 1px solid #ddd;
        border-radius: 40px;
        font-size: 15px;
        color: #232323;
        background: #fff;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .articles-list-widget .search-bar input:focus {
        border-color: #28ABE3;
    }

    .articles-list-widget .search-bar .search-icon {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #28ABE3;
        font-size: 16px;
        pointer-events: none;
    }

    .articles-list-widget .search-bar .clear-btn {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #aaa;
        font-size: 18px;
        cursor: pointer;
        display: none;
        background: none;
        border: none;
        line-height: 1;
        padding: 0;
    }

    .articles-list-widget .search-bar .clear-btn:hover {
        color: #28ABE3;
    }
</style>

<section class="articles-list-widget" id="@widgetId">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8">
                <div class="section-title text-center">
                    <h2>@Model.SectionTitle.Replace(Model.SectionTitleHighlight, "").Trim() <span>@Model.SectionTitleHighlight</span></h2>
                    <div class="title-border"></div>
                    @if (!string.IsNullOrEmpty(Model.SectionSubtitle))
                    {
                        <p>@Model.SectionSubtitle</p>
                    }
                </div>
            </div>
        </div>

        <div class="search-bar">
            <div class="search-wrap">
                <input type="text" id="@(widgetId)-search" placeholder="Search articles..." autocomplete="off" />
                <button class="clear-btn" id="@(widgetId)-clear" title="Clear">&times;</button>
            </div>
        </div>

        @if (Model.Categories.Any())
        {
            <div class="filter-bar">
                <button class="filter-btn active" data-filter="">All</button>
                @foreach (var cat in Model.Categories)
                {
                    <button class="filter-btn" data-filter="@cat">@cat</button>
                }
            </div>
        }

        <div class="row" id="@(widgetId)-grid">
            @foreach (var article in Model.Articles)
            {
                var thumbnailUrl = article.ArticleThumbnail?.FirstOrDefault()?.Thumbnail?.Url ?? "";
                var articleUrl = Url.Content(article.GetUrl().RelativePath);
                var plainContent = System.Text.RegularExpressions.Regex.Replace(article.ArticleContent ?? "", "<.*?>", "");
                var excerpt = plainContent.Length > 150 ? plainContent.Substring(0, 150) + "..." : plainContent;
                var articleTags = article.ArticleTaxonomy?
                    .Select(t => Model.TagTitles.TryGetValue(t.Identifier, out var title) ? title : "")
                    .Where(t => !string.IsNullOrEmpty(t))
                    .ToList() ?? new List<string>();
                var tagsString = string.Join(",", articleTags);

                <article class="col-lg-4 col-md-6 article-card" data-tags="@tagsString" data-title="@article.ArticleTitle?.ToLower()" data-content="@plainContent.ToLower()">
                    <div class="post-item">
                        @if (!string.IsNullOrEmpty(thumbnailUrl))
                        {
                            <div class="media-wrapper">
                                <img loading="lazy" src="@thumbnailUrl" alt="@article.ArticleTitle" class="img-fluid">
                            </div>
                        }
                        <div class="content">
                            @if (articleTags.Any())
                            {
                                <span class="article-category">@string.Join(", ", articleTags)</span>
                            }
                            <h3><a href="@articleUrl">@article.ArticleTitle</a></h3>
                            <p>@excerpt</p>
                            <a class="btn-article" href="@articleUrl">Read more</a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <p class="no-results" id="@(widgetId)-no-results">No articles found.</p>

        <div class="pagination-bar" id="@(widgetId)-pagination"></div>

    </div>
</section>

<script>
    (function () {
        var PAGE_SIZE = 5;
        var widgetEl   = document.getElementById('@widgetId');
        var cards      = Array.from(widgetEl.querySelectorAll('.article-card'));
        var paginationEl = document.getElementById('@(widgetId)-pagination');
        var noResults  = document.getElementById('@(widgetId)-no-results');
        var filterBtns = widgetEl.querySelectorAll('.filter-btn');
        var searchInput = document.getElementById('@(widgetId)-search');
        var clearBtn   = document.getElementById('@(widgetId)-clear');

        var currentFilter = '';
        var currentSearch = '';
        var currentPage   = 1;

        function getFiltered() {
            return cards.filter(function (c) {
                var matchesCategory = currentFilter === '' ||
                    (c.dataset.tags && c.dataset.tags.split(',').indexOf(currentFilter) !== -1);
                var matchesSearch   = currentSearch === '' ||
                    (c.dataset.title && c.dataset.title.includes(currentSearch)) ||
                    (c.dataset.content && c.dataset.content.includes(currentSearch));
                return matchesCategory && matchesSearch;
            });
        }

        function render() {
            var filtered   = getFiltered();
            var totalPages = Math.ceil(filtered.length / PAGE_SIZE);
            if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

            cards.forEach(function (c) { c.classList.remove('visible'); });
            var start = (currentPage - 1) * PAGE_SIZE;
            filtered.slice(start, start + PAGE_SIZE).forEach(function (c) { c.classList.add('visible'); });

            noResults.style.display = filtered.length === 0 ? 'block' : 'none';
            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            paginationEl.innerHTML = '';
            if (totalPages <= 1) return;

            paginationEl.appendChild(makePageBtn('&#8249;', currentPage - 1, currentPage <= 1));
            for (var p = 1; p <= totalPages; p++) {
                paginationEl.appendChild(makePageBtn(p, p, false, p === currentPage));
            }
            paginationEl.appendChild(makePageBtn('&#8250;', currentPage + 1, currentPage >= totalPages));
        }

        function makePageBtn(label, page, disabled, active) {
            var btn = document.createElement('span');
            btn.className = 'page-btn' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
            btn.innerHTML = label;
            if (!disabled) {
                btn.addEventListener('click', function () {
                    currentPage = page;
                    render();
                    widgetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }
            return btn;
        }

        // Category filter
        filterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                filterBtns.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                currentPage   = 1;
                render();
            });
        });

        // Search — resets category to All
        searchInput.addEventListener('input', function () {
            currentSearch = searchInput.value.trim().toLowerCase();
            clearBtn.style.display = currentSearch ? 'block' : 'none';

            // reset category filter
            filterBtns.forEach(function (b) { b.classList.remove('active'); });
            var allBtn = widgetEl.querySelector('.filter-btn[data-filter=""]');
            if (allBtn) allBtn.classList.add('active');
            currentFilter = '';
            currentPage   = 1;
            render();
        });

        // Clear button
        clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            currentSearch = '';
            clearBtn.style.display = 'none';
            currentPage = 1;
            render();
            searchInput.focus();
        });

        render();
    })();
</script>
