@using FinalProject
@using FinalProject.Widgets
@using CMS.Websites

@model FinalProject.Widgets.ServicesListWidgetViewModel

@{
    var widgetId = $"sl_{Guid.NewGuid().ToString("N").Substring(0, 8)}";
}

<style>
    .services-list-widget {
        padding: 80px 0 60px;
        background: #F6F6F6;
    }

    .services-list-widget .section-title {
        padding-bottom: 50px;
        overflow: hidden;
    }

    .services-list-widget .section-title h2 {
        font-weight: 600;
        font-size: 35px;
        color: #232323;
    }

    .services-list-widget .section-title h2 span {
        color: #28ABE3;
    }

    .services-list-widget .title-border {
        height: 2px;
        margin: 20px auto;
        width: 80px;
        background: #28ABE3;
    }

    .services-list-widget .section-title p {
        color: #848484;
        margin: 0 auto;
    }

    .services-list-widget .filter-bar {
        margin-bottom: 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

    .services-list-widget .filter-btn {
        display: inline-block;
        padding: 8px 22px;
        border: 1px solid #28ABE3;
        border-radius: 40px;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #28ABE3;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .services-list-widget .filter-btn:hover,
    .services-list-widget .filter-btn.active {
        background: #28ABE3;
        color: #fff;
    }

    .services-list-widget .post-item {
        background: #fff;
        margin-bottom: 30px;
    }

    .services-list-widget .post-item .media-wrapper img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
    }

    .services-list-widget .post-item .content {
        padding: 20px;
    }

    .services-list-widget .post-item .content .service-category {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #28ABE3;
        margin-bottom: 8px;
        display: block;
    }

    .services-list-widget .post-item .content h3 a {
        color: #000;
        text-decoration: none;
    }

    .services-list-widget .post-item .content h3 a:hover {
        color: #28ABE3;
    }

    .services-list-widget .post-item .content p {
        color: #757575;
        margin: 10px 0;
    }

    .services-list-widget .btn-service {
        background: #28ABE3;
        border: 1px solid #28ABE3;
        color: #fff;
        display: inline-block;
        font-size: 14px;
        letter-spacing: 1px;
        padding: 12px 25px;
        text-transform: uppercase;
        border-radius: 40px;
        text-decoration: none;
        margin: 15px 0;
        transition: opacity 0.3s ease;
    }

    .services-list-widget .btn-service:hover {
        opacity: 0.8;
        color: #fff;
        text-decoration: none;
    }

    .services-list-widget .service-card {
        display: none;
    }

    .services-list-widget .service-card.visible {
        display: block;
    }

    .services-list-widget .pagination-bar {
        margin-top: 40px;
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .services-list-widget .page-btn {
        display: inline-block;
        width: 40px;
        height: 40px;
        line-height: 38px;
        text-align: center;
        border: 1px solid #28ABE3;
        border-radius: 50%;
        font-size: 14px;
        color: #28ABE3;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
        user-select: none;
    }

    .services-list-widget .page-btn:hover,
    .services-list-widget .page-btn.active {
        background: #28ABE3;
        color: #fff;
    }

    .services-list-widget .page-btn.disabled {
        border-color: #ccc;
        color: #ccc;
        pointer-events: none;
    }

    .services-list-widget .no-results {
        color: #848484;
        text-align: center;
        padding: 40px 0;
        display: none;
    }
</style>

<section class="services-list-widget" id="@widgetId">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8">
                <div class="section-title text-center">
                    <h2>@Model.SectionTitle.Replace(Model.SectionTitleHighlight, "").Trim() <span>@Model.SectionTitleHighlight</span></h2>
                    <div class="title-border"></div>
                    @if (!string.IsNullOrEmpty(Model.SectionSubtitle))
                    {
                        <p>@Model.SectionSubtitle</p>
                    }
                </div>
            </div>
        </div>

        @if (Model.Categories.Any())
        {
            <div class="filter-bar">
                <button class="filter-btn active" data-filter="">All</button>
                @foreach (var cat in Model.Categories)
                {
                    <button class="filter-btn" data-filter="@cat">@cat</button>
                }
            </div>
        }

        <div class="row" id="@(widgetId)-grid">
            @foreach (var service in Model.Services)
            {
                var thumbnailUrl = service.ServicesThumbnail?.FirstOrDefault()?.Thumbnail?.Url ?? "";
                var serviceUrl = Url.Content(service.GetUrl().RelativePath);
                var plainContent = System.Text.RegularExpressions.Regex.Replace(service.ServicesContent ?? "", "<.*?>", "");
                var excerpt = plainContent.Length > 150 ? plainContent.Substring(0, 150) + "..." : plainContent;

                <article class="col-lg-4 col-md-6 service-card" data-category="@service.ServicesCategory">
                    <div class="post-item">
                        @if (!string.IsNullOrEmpty(thumbnailUrl))
                        {
                            <div class="media-wrapper">
                                <img loading="lazy" src="@thumbnailUrl" alt="@service.ServicesTitle" class="img-fluid">
                            </div>
                        }
                        <div class="content">
                            @if (!string.IsNullOrEmpty(service.ServicesCategory))
                            {
                                <span class="service-category">@service.ServicesCategory</span>
                            }
                            <h3><a href="@serviceUrl">@service.ServicesTitle</a></h3>
                            <p>@excerpt</p>
                            <a class="btn-service" href="@serviceUrl">Read more</a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <p class="no-results" id="@(widgetId)-no-results">No services found.</p>

        <div class="pagination-bar" id="@(widgetId)-pagination"></div>

    </div>
</section>

<script>
    (function () {
        var PAGE_SIZE = 5;
        var widgetEl = document.getElementById('@widgetId');
        var cards = Array.from(widgetEl.querySelectorAll('.service-card'));
        var paginationEl = document.getElementById('@(widgetId)-pagination');
        var noResults = document.getElementById('@(widgetId)-no-results');
        var filterBtns = widgetEl.querySelectorAll('.filter-btn');

        var currentFilter = '';
        var currentPage = 1;

        function getFiltered() {
            return currentFilter === ''
                ? cards
                : cards.filter(function (c) { return c.dataset.category === currentFilter; });
        }

        function render() {
            var filtered = getFiltered();
            var totalPages = Math.ceil(filtered.length / PAGE_SIZE);
            if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

            cards.forEach(function (c) { c.classList.remove('visible'); });
            var start = (currentPage - 1) * PAGE_SIZE;
            filtered.slice(start, start + PAGE_SIZE).forEach(function (c) { c.classList.add('visible'); });

            noResults.style.display = filtered.length === 0 ? 'block' : 'none';

            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            paginationEl.innerHTML = '';
            if (totalPages <= 1) return;

            paginationEl.appendChild(makePageBtn('&#8249;', currentPage - 1, currentPage <= 1));

            for (var p = 1; p <= totalPages; p++) {
                paginationEl.appendChild(makePageBtn(p, p, false, p === currentPage));
            }

            paginationEl.appendChild(makePageBtn('&#8250;', currentPage + 1, currentPage >= totalPages));
        }

        function makePageBtn(label, page, disabled, active) {
            var btn = document.createElement('span');
            btn.className = 'page-btn' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
            btn.innerHTML = label;
            if (!disabled) {
                btn.addEventListener('click', function () {
                    currentPage = page;
                    render();
                    widgetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }
            return btn;
        }

        filterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                filterBtns.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                currentPage = 1;
                render();
            });
        });

        render();
    })();
</script>
