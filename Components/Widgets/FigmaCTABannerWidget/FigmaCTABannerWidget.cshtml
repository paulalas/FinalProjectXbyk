@using FinalProject.Widgets

@model FinalProject.Widgets.FigmaCTABannerWidgetViewModel

<style>
  .fctab-banner{
    position:relative;
    background:#142257;
    overflow:hidden;
  }
  .fctab-inner{
    max-width:1440px;
    margin:0 auto;
    padding:56px 40px;
    display:flex;
    align-items:center;
    gap:48px;
    min-height:520px;
  }

  /* content */
  .fctab-content{
    flex:1 1 560px;
    display:flex;
    flex-direction:column;
    gap:36px;
    position:relative;
    z-index:2;
  }
  .fctab-text{ display:flex; flex-direction:column; gap:24px; align-items:flex-start; }
  .fctab-title{
    font-weight:800;
    font-size:clamp(2.4rem,4.4vw,4rem);
    line-height:1.19;
    color:#FFFFFF;
  }
  .fctab-features{ display:flex; gap:41px; flex-wrap:wrap; }
  .fctab-feature-item{
    display:flex; align-items:center; gap:8px;
    color:#15B2F5;
    font-weight:500;
    font-size:1.25rem;
    line-height:1.6;
    white-space:nowrap;
  }
  .fctab-feature-item i{ font-size:22px; line-height:1; }

  /* CTA button */
  .fctab-cta{
    align-self:flex-start;
    display:inline-flex; align-items:center;
    background:#15B2F5;
    border:none; border-radius:60px;
    padding:8px;
    cursor:pointer;
    text-decoration:none;
    transition:transform .15s ease, box-shadow .15s ease;
    box-shadow:0 14px 34px -10px rgba(21,178,245,.55);
  }
  .fctab-cta:hover{ transform:translateY(-2px); box-shadow:0 18px 40px -10px rgba(21,178,245,.7); }
  .fctab-cta .fctab-btn-text{
    padding:8px 16px;
    color:#FFFFFF; font-weight:700; font-size:1.5rem; line-height:1.33; white-space:nowrap;
    font-family:inherit;
  }
  .fctab-cta .fctab-icon{
    width:48px; height:48px; border-radius:50%;
    background:#FFFFFF;
    display:grid; place-items:center; flex-shrink:0;
  }
  .fctab-cta .fctab-icon svg{ width:24px; height:24px; fill:#15B2F5; }

  /* image panel */
  .fctab-image{
    flex:1 1 460px;
    align-self:stretch;
    position:relative;
    min-height:380px;
    border-radius:18px;
    overflow:hidden;
    background:linear-gradient(135deg,#3a4f86,#1c2a5e);
  }
  .fctab-image img{
    position:absolute;
    inset:0;
    width:100%; height:100%;
    object-fit:cover; object-position:center;
    display:block;
  }
  .fctab-image-ph{
    position:absolute;
    inset:0;
    display:grid;
    place-items:center;
  }
  .fctab-app-logo{
    width:120px; height:120px; border-radius:26px;
    background:#15B2F5;
    box-shadow:0 18px 44px rgba(19,171,236,.48);
    display:grid; place-items:center;
  }
  .fctab-app-logo svg{ width:62px; height:62px; }

  /* top notch */
  .fctab-notch{
    position:absolute;
    top:0; left:16%;
    width:360px; height:34px;
    background:#FFFFFF;
    clip-path:polygon(0 0,100% 0,86% 100%,14% 100%);
    z-index:3;
  }

  @@media (max-width:760px){
    .fctab-inner{
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap:32px;
      padding:48px 24px 0;
      min-height:0;
    }
    .fctab-content{ flex:none; align-items:center; gap:24px; }
    .fctab-text{ align-items:center; gap:18px; }
    .fctab-title{ font-size:1.7rem; }
    .fctab-features{ justify-content:center; gap:10px 22px; }
    .fctab-feature-item{ font-size:1.02rem; }
    .fctab-feature-item i{ font-size:18px; }
    .fctab-cta{ align-self:center; }
    .fctab-cta .fctab-btn-text{ font-size:1.3rem; }
    .fctab-image{
      flex:none; width:100%; min-height:260px;
      border-radius:0;
    }
    .fctab-app-logo{ width:92px; height:92px; border-radius:20px; }
    .fctab-app-logo svg{ width:48px; height:48px; }
    .fctab-notch{ left:14%; width:240px; height:28px; }
  }
</style>

<section class="fctab-banner">
  <div class="fctab-notch"></div>
  <div class="fctab-inner">

    <div class="fctab-content">
      <div class="fctab-text">
        <h2 class="fctab-title">@Model.Title</h2>

        @if (Model.FeatureItems.Any())
        {
          <div class="fctab-features">
            @foreach (var item in Model.FeatureItems)
            {
              <span class="fctab-feature-item">
                @if (!string.IsNullOrEmpty(item.Icon))
                {
                  <i class="@item.Icon"></i>
                }
                @item.Title
              </span>
            }
          </div>
        }
      </div>

      <a href="@Model.CtaLink" class="fctab-cta">
        <span class="fctab-btn-text">@Model.CtaText</span>
        <span class="fctab-icon">
          <svg viewBox="0 0 24 24">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .7-.2 1l-2.3 2.2z"/>
          </svg>
        </span>
      </a>
    </div>

    <div class="fctab-image">
      @if (!string.IsNullOrEmpty(Model.ImageUrl))
      {
        <img src="@Model.ImageUrl" alt="">
      }
      else
      {
        <div class="fctab-image-ph">
          <div class="fctab-app-logo">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 11.5 12 5l8 6.5V20a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1z" fill="#fff"/>
            </svg>
          </div>
        </div>
      }
    </div>

  </div>
</section>
