@using Kentico.Web.Mvc
@using Kentico.PageBuilder.Web.Mvc

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomePro — Home Repair & Improvement</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <page-builder-styles />

    <style>
        :root {
            --navy:        #182456;
            --navy-deep:   #131d49;
            --blue-accent: #5b8def;
            --blue-soft:   #8fa6d8;
            --blue-btn-1:  #2f7bff;
            --blue-btn-2:  #1f6bf0;
            --red-dot:     #ff4d4d;
            --white:       #ffffff;
            --muted:       #aeb8d6;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Poppins', system-ui, -apple-system, sans-serif;
            background: #f2f4fa;
            color: var(--white);
            -webkit-font-smoothing: antialiased;
        }

        /* ---------- Top navigation ---------- */
        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 22px 40px;
            position: relative;
            z-index: 5;
            background: var(--navy);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-weight: 700;
            font-size: 1.35rem;
            letter-spacing: .2px;
            color: var(--white);
            text-decoration: none;
        }

        .brand .logo {
            width: 24px;
            height: 24px;
            display: grid;
            place-items: center;
        }

        .brand svg { width: 24px; height: 24px; }

        .nav-links {
            display: flex;
            gap: 38px;
            list-style: none;
        }

        .nav-links a {
            color: var(--white);
            text-decoration: none;
            font-size: .95rem;
            font-weight: 500;
            opacity: .92;
            transition: opacity .2s;
        }

        .nav-links a:hover { opacity: 1; color: var(--blue-accent); }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .95rem;
            font-weight: 500;
            color: var(--white);
        }

        .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--red-dot);
            box-shadow: 0 0 0 4px rgba(255, 77, 77, .18);
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 760px) {
            .nav { display: none; }
        }
    </style>
</head>

<body>

    <!-- ===== Navigation ===== -->
    <nav class="nav">
        <a href="/" class="brand">
            <span class="logo">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L3 9v12a1 1 0 0 0 1 1h6v-7h4v7h6a1 1 0 0 0 1-1V9l-9-7z" fill="#5b8def"/>
                    <circle cx="12" cy="9" r="2.4" fill="#fff"/>
                </svg>
            </span>
            HomePro
        </a>

        <ul class="nav-links">
            <li><a href="#">About Us</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Our Blog</a></li>
            <li><a href="#">Contact</a></li>
        </ul>

        <div class="nav-right">
            <span class="dot"></span>
            24 Hour Services
        </div>
    </nav>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <page-builder-scripts />
</body>
</html>
